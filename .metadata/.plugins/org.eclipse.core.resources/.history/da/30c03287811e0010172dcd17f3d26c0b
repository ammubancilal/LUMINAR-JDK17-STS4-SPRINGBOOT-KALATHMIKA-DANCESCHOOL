<%@ page contentType="text/html;charset=UTF-8"%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kalathmika Admin Dashboard</title>
<style>
body {
	font-family: Arial, sans-serif;
	margin: 0;
	padding: 0;
	background-color: #f4f4f4;
}

/* Header section styling */
.header {
	background-color: #9C27B0;
	padding: 15px 30px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
	color: white;
	text-align: center;
}

.text-block {
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: center;
}

.header-left {
	display: flex;
	align-items: center;
}

.header-left img {
	height: 50px;
	margin-right: 15px;
}

.header-left h2 {
	margin: 0;
	font-size: 26px;
	font-weight: 600;
}

.header-right a {
	text-decoration: none;
	color: white;
	font-weight: bold;
	padding: 8px 16px;
	border: 2px solid white;
	border-radius: 5px;
	transition: background-color 0.3s, color 0.3s;
}

.header-right a:hover {
	background-color: white;
	color: #9C27B0;
}

hr {
	border: 1px solid #ccc;
	margin: 0;
}
</style>
</head>
<body>

	<div class="header">
		<div class="header-left">
			<img src="${pageContext.request.contextPath}/images/nadaraja.jpg"
				alt="Kalathmika Logo">
			<div class="text-block">
				<h1>KALATHMIKA</h1>
				<h2>School of Classical Dance</h2>
			</div>
		</div>
		<div class="header-right">
			<a href="${pageContext.request.contextPath}/logout">Sign Out</a>
		</div>
	</div>

	<hr>

</body>
</html>
