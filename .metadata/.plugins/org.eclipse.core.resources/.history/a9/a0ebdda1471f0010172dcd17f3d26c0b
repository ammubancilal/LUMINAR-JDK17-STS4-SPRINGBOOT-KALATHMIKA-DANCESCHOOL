package com.luminar.springbootkalathmika.controller;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;

import com.luminar.springbootkalathmika.model.Student;
import com.luminar.springbootkalathmika.service.StudentService;


@Controller
@RequestMapping("/admin")
public class StudentController {
	 @GetMapping("/admin/manageStudents")
	    public String manageStudentsPage() {
	        // This returns the view name (JSP page)
	        return "manageStudents"; // Resolves to /WEB-INF/views/manageStudents.jsp
	    }

	 @GetMapping("/addNewStudent")
	    public String showAddStudentForm(Model model) {
	        // Optionally add an empty student object to bind form data
	        model.addAttribute("student", new Student());
	        return "addNewStudent"; // This should match the JSP name: addStudent.jsp
	    }
	 
	 @PostMapping("/saveStudent")
	 public String saveStudent(@ModelAttribute("student") Student student) {
	     // You should have a service/repo to handle DB save
	     return "redirect:/manageStudents";   // Redirect after saving to student list
	 }
	 
	 
}
