<%@ page import="java.util.List" %>
<%@ page import="com.luminar.springbootkalathmika.model.Dance" %>
<html>
<head>
<style>
td button {
            margin: 0 5px;
            padding: 6px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .edit-btn {
            background-color: #4CAF50;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }

</style>


</head>
<%
    List<Dance> dances = (List<Dance>) request.getAttribute("dance");
    int index = 1;
    if (dances != null) {
        for (Dance dance : dances) {
%>
    <tr>
        <td><%= index++ %></td>
        <td><%= dance.getDance_name() %></td>
        <td><%= dance.getDance_desc() %></td>
        <td><%= dance.getDance_origin_state() %></td>
        
        <td>
            <button class="edit-btn" onclick="location.href='editStudent?stu_id=<%= student.getStu_id() %>'">Edit</button>
           <td> <button class="delete-btn" onclick="if(confirm('Are you sure?')) location.href='deleteStudent?stu_id=<%= student.getStu_id() %>'">Delete</button>
        </td>
    </tr>
<%
        }
    }
%>
</html>