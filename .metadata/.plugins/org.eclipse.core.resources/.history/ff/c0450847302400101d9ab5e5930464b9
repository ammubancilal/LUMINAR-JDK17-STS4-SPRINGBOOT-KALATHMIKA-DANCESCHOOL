<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.luminar.springbootkalathmika.model.Student" %>
<%@ include file="header.jsp" %>

<%
    Student student = (Student) request.getAttribute("StudentRecord");
%>

<!DOCTYPE html>
<html>
<head>
    <title>My Profile</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background: #f3f4f7;
            color: #333;
        }
        
        /* Profile container */
        .profile-container {
            max-width: 800px;
            margin: 50px auto;
            background: #fff;
            padding: 40px;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
            border-radius: 15px;
            overflow: hidden;
        }

        /* Header */
        h1 {
            text-align: center;
            color: #6A1B9A;
            margin-bottom: 30px;
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Profile field styles */
        .profile-field {
            margin-bottom: 20px;
            font-size: 18px;
            line-height: 1.6;
        }

        .profile-label {
            font-weight: bold;
            color: #6A1B9A;
        }

        .profile-value {
            margin-left: 10px;
            color: #555;
        }

        /* Buttons */
        .btn-container {
            text-align: center;
            margin-top: 30px;
        }

        .btn {
            background-color: #6A1B9A;
            color: white;
            padding: 12px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-size: 18px;
            transition: background-color 0.3s ease, transform 0.2s ease-in-out;
        }

        .btn:hover {
            background-color: #9C27B0;
            transform: scale(1.05);
        }

        .btn:focus {
            outline: none;
        }

        /* Add a subtle hover effect on each profile field */
        .profile-field:hover {
            background-color: #f5f5f5;
            transition: background-color 0.3s ease;
            padding: 10px;
            border-radius: 5px;
        }

        /* Box shadow for the profile field on hover */
        .profile-value {
            display: inline-block;
            transition: box-shadow 0.3s ease;
        }

        .profile-value:hover {
            box-shadow: 0 0 10px rgba(106, 27, 154, 0.3);
        }

        /* Media query for mobile responsiveness */
        @media (max-width: 768px) {
            .profile-container {
                padding: 20px;
                margin: 30px;
            }

            h1 {
                font-size: 28px;
            }

            .btn {
                padding: 12px 25px;
                font-size: 16px;
            }

            .profile-field {
                font-size: 16px;
            }
        }

        /* Adding a border to separate sections */
        .profile-field {
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 10px;
        }

        .profile-field:last-child {
            border-bottom: none;
        }
    </style>
</head>
<body>

<div class="profile-container">
    <h1>My Profile</h1>

    <% if (student != null) { %>
        <div class="profile-field">
            <span class="profile-label">Name:</span>
            <span class="profile-value"><%= student.getStuName() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Parent Name:</span>
            <span class="profile-value"><%= student.getStuParentname() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Email:</span>
            <span class="profile-value"><%= student.getStuEmail() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Phone:</span>
            <span class="profile-value"><%= student.getStuContactnumber() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Address:</span>
            <span class="profile-value"><%= student.getStuAddress() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Date of Birth:</span>
            <span class="profile-value"><%= student.getStuDob() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Gender:</span>
            <span class="profile-value"><%= student.getStuGender() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Dance Form Opted:</span>
            <span class="profile-value"><%= student.getStuDanceform() %></span>
        </div>

        <div class="profile-field">
            <span class="profile-label">Joining Date:</span>
            <span class="profile-value"><%= student.getStuDateofJoin() %></span>
        </div>

        <div class="btn-container">
            <a href="/student/editProfile" class="btn">Edit Profile</a>
        </div>
    <% } else { %>
        <p style="text-align:center; color:red;">No student information found.</p>
    <% } %>
</div>

</body>
</html>

<%@ include file="footer.jsp" %>
