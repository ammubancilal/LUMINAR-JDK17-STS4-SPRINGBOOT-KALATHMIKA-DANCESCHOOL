package com.luminar.springbootkalathmika.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;

import com.luminar.springbootkalathmika.model.Event;
import com.luminar.springbootkalathmika.service.EventService;

@Controller
@RequestMapping("/admin")
public class EventController {
	
	
	@Autowired
    private EventService eventService;

    // ✅ Map the /admin/Events to events.jsp
    @GetMapping("/Events")
    public String showEventsPage(Model model) {
        List<Event> events = eventService.getAllEvents(); // Fetch all events
        model.addAttribute("events", events);             // Pass list to JSP
        return "events";  // => loads events.jsp
    }
    
    
    
    @GetMapping("/addNewEvent")
    public String addNewEventForm() {
        return "addNewEvent"; // returns addNewEvent.jsp
    }
    
    @PostMapping("/saveEvent")
    public String saveEvent(@ModelAttribute Event event) {
        eventService.saveEvent(event); // Save the event using the service
        return "redirect:/admin/Events"; // Redirect back to events listing page
    }
    
    
 // Show the event details for editing
    @GetMapping("/editEvent")
    public String showEditEventPage(@RequestParam("event_id") int eventId, Model model) {
        // Fetch the event from the database
        Event event = eventService.getEventById(eventId);
        
        // Add the event object to the model to display it on the JSP page
        model.addAttribute("event", event);
        
        // Return the name of the JSP page for editing the event
        return "editEvent"; // This is the JSP page that will show the event details for editing
    }
    
    
    @PostMapping("/updateEvent")
    public String updateEvent(@ModelAttribute("event") Event event) {
        eventService.updateEvent(event); // Save will update if ID is present
        return "redirect:/admin/Events"; // After update, redirect to events list
    }
    
    
 // ✅ Controller method to delete an event
    @GetMapping("/deleteEvent")
    public String deleteEvent(@RequestParam("event_id") int eventId) {
        eventService.deleteEvent(eventId); // Call service to delete by id
        return "redirect:/admin/Events";   // After delete, redirect to event list
    }
    
    
    // ✅ Fetch all events (used to reload the event list when search input is cleared)
    @GetMapping("/loadAllEvents")
    public String loadAllEvents(Model model) {
        List<Event> events = eventService.getAllEvents(); // Fetch all events from the service
        model.addAttribute("events", events);  // Add events list to the model
        return "eventTable";  // Return a partial HTML fragment (for table rows)
    }
    
    @GetMapping("/student/loadAllEvents")
    public String loadAllEventsStudent(Model model) {
        List<Event> events = eventService.getAllEvents(); // Fetch all events from the service
        model.addAttribute("events", events);  // Add events list to the model
        return "studentViewEventsRows";  // Return a partial HTML fragment (for table rows)
    }
    
    
    
    
 // Search events by name
    @GetMapping("/searchEvent")
    public String searchEvent(@RequestParam("keyword") String keyword, Model model) {
        List<Event> events = eventService.searchEventsByName(keyword); // Call service to search events
        model.addAttribute("events", events);  // Add search result events to the model
        return "eventTable";  // Return the partial HTML fragment (table rows)
    }
    
    
 // Search events by name
    @GetMapping("/student/searchEvent")
    public String searchEventStudent(@RequestParam("keyword") String keyword, Model model) {
        List<Event> events = eventService.searchEventsByName(keyword); // Call service to search events
        model.addAttribute("events", events);  // Add search result events to the model
        return "studentViewEventRows";  // Return the partial HTML fragment (table rows)
    }
    

}
