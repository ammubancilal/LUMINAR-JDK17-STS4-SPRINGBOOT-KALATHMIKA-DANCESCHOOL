package com.luminar.springbootkalathmika.model;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;

@Entity
@Table(name = "trackfees") // Use your actual DB table name
public class TrackFees {
	 @Id
	private int fee_id;
	 private int stu_id;
	 private String fee_month;
	 private String fee_year;
	 
	  @Column(name = "fee_amount_paid")
	 private int feeAmountpaid;
	  
	  @Column(name = "fee_payment_date")
	  private String feePaymentdate;
	  
	  @Column(name = "fee_payment_status")
	  private String feePaymentstatus;
	
	
	

}
