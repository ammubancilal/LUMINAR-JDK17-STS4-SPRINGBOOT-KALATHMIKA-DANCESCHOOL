<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ page import="com.luminar.springbootkalathmika.model.Student" %>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<c:choose>
    <c:when test="${not empty students}">
        <c:forEach var="student" items="${students}" varStatus="loop">
            <tr>
                <td>${loop.index + 1}</td>
                <td>${student.stu_name}</td>
                <td>${student.stu_dob}</td>
                <td>${student.stu_gender}</td>
                <td>${student.stu_parent_name}</td>
                <td>${student.stu_contact_number}</td>
                <td>${student.stu_email}</td>
                <td>${student.stu_address}</td>
                <td>${student.stu_dateof_join}</td>
                <td>${student.stu_dance_form}</td>
                <td>${student.stu_level}</td>
                <td>
                    <c:url var="editUrl" value="editStudent">
                        <c:param name="stu_id" value="${student.stu_id}" />
                    </c:url>
                    <button class="edit-btn" onclick="location.href='${editUrl}'">Edit</button>
                </td>
                <td>
                    <c:url var="deleteUrl" value="deleteStudent">
                        <c:param name="stu_id" value="${student.stu_id}" />
                    </c:url>
                    <button class="delete-btn" onclick="if(confirm('Are you sure?')) location.href='${deleteUrl}'">Delete</button>
                </td>
            </tr>
        </c:forEach>
    </c:when>
    <c:otherwise>
        <tr>
            <td colspan="13">No students found.</td>
        </tr>
    </c:otherwise>
</c:choose>
