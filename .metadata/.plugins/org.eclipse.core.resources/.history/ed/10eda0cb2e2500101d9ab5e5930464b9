package com.luminar.springbootkalathmika.controller;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;

import com.luminar.springbootkalathmika.model.ClassStudent;
import com.luminar.springbootkalathmika.model.Student;
import com.luminar.springbootkalathmika.repository.ClassStudentRepository;
import com.luminar.springbootkalathmika.service.ClassStudentService;
import com.luminar.springbootkalathmika.service.StudentService;

import jakarta.servlet.http.HttpSession;

@Controller
public class ClassStudentController {
	
	@Autowired
    private ClassStudentService classStudentService;
	
	@Autowired
    private ClassStudentRepository classStudentRepository;
	
	
	@Autowired
    private StudentService studentService;
	
	  @GetMapping("/admin/student/myClasses")
	    public String viewMyClasses(HttpSession session,Model model) {
		  Integer studentId = (Integer) session.getAttribute("StudentId");
		    System.out.println("studentId is"+studentId);

		    if (studentId == null) {
		        model.addAttribute("errorMessage", "Student not found!");
		        return "studentLogin";
		    }

		    // Fetch the full student object based on studentId
		    Student student = studentService.getStudentById(studentId);

		    if (student == null) {
		        model.addAttribute("errorMessage", "Student not found!");
		        return "errorPage"; // Show error page if student is not found
		    }

		    // Add the full student object to the model
		    model.addAttribute("StudentRecord", student);
           
		    
		    
		  
		  
		  
		  
	        List<ClassStudent> classes = classStudentService.getAllClasses();
	        model.addAttribute("classesStudent", classes);
	        return "StudentViewClasses"; // JSP page name (myClasses.jsp)
	    }
	  
	  @GetMapping("/admin/classSchedule")
	  public String viewClassSchedule(Model model) {
		  List<ClassStudent> classes = classStudentService.getAllClasses();
	        model.addAttribute("classSchedule", classes);

	      return "classSchedule"; // This should match your JSP or Thymeleaf page name (classSchedule.jsp or classSchedule.html)
	  }
	  
	  @GetMapping("/admin/addClassSchedule")
	  public String showAddClassScheduleForm(Model model) {
	      // If you need to pass an empty object to the form
	      
	      
	      return "addClassSchedule"; // This should match your JSP page name (like addClassSchedule.jsp)
	  }
	  
	  @PostMapping("/admin/saveClass")
	  public String saveClass(@ModelAttribute ClassStudent classSchedule) {
	      // Save the class schedule object using your service or repository
		  classStudentRepository.save(classSchedule);

	      // After saving, redirect to class schedule list or success page
	      return "redirect:/admin/classSchedule";
	  }
	  
	  
	  @GetMapping("/editClass")
	  public String editClass(@RequestParam("classId") Long classId, Model model) {
	      // Fetch the class schedule by ID
	      Optional<ClassStudent> classScheduleOpt = classScheduleRepository.findById(classId);

	      if (classScheduleOpt.isPresent()) {
	          ClassStudent classSchedule = classScheduleOpt.get();
	          model.addAttribute("classSchedule", classSchedule);
	          return "editClassForm"; // Return the JSP page to edit the class
	      } else {
	          return "redirect:/admin/classScheduleList"; // If not found, redirect back
	      }
	  }



	  
	  

}
