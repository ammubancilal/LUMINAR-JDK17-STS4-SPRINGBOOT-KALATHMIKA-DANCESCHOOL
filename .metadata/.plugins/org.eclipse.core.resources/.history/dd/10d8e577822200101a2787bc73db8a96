<%@ page contentType="text/html;charset=UTF-8" language="java"%>
<%@ include file="header.jsp"%>
<%@ page import="java.util.List"%>
<%@ page import="com.luminar.springbootkalathmika.model.Event"%>

<%
    List<Event> events = (List<Event>) request.getAttribute("events");
%>

<html>
<head>
<title>Manage Events</title>

<style>
html, body {
	height: 100%;
	margin: 0;
	display: flex;
	flex-direction: column;
}

.manage-container {
	width: fit-content;
	margin: 40px auto;
	background-color: #fff;
	padding: 30px;
	box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
	font-family: Arial, sans-serif;
	border-radius: 10px;
	overflow-x: auto;
}

.manage-container h2 {
	text-align: center;
	color: #9C27B0;
	margin-bottom: 30px;
}

ul.nav-menu {
	list-style-type: none;
	padding: 0;
	margin: 20px auto 0 auto;
	display: flex;
	justify-content: center;
	gap: 25px;
}

ul.nav-menu li a {
	text-decoration: none;
	background-color: #9C27B0;
	color: white;
	padding: 12px 20px;
	border-radius: 8px;
}

ul.nav-menu li a:hover {
	background-color: #7B1FA2;
}

.action-bar {
	display: flex;
	justify-content: space-between;
	margin-bottom: 20px;
}

.action-bar input[type="text"] {
	padding: 8px;
	width: 250px;
	border: 1px solid #ccc;
	border-radius: 5px;
}

.action-bar button {
	background-color: #9C27B0;
	color: white;
	border: none;
	padding: 10px 16px;
	border-radius: 5px;
	cursor: pointer;
}

.action-bar button:hover {
	background-color: #7B1FA2;
}

table, th, td {
	border: 1px solid #ddd;
}

table {
	width: 100%;
	border-collapse: collapse;
	margin-bottom: 30px;
}

th, td {
	padding: 12px;
	text-align: left;
	border-bottom: 1px solid #ccc;
}

th {
	background-color: #9C27B0;
	color: white;
}

.edit-btn {
	background-color: #4CAF50;
	color: white;
	padding: 8px 12px;
	border-radius: 5px;
}

.delete-btn {
	background-color: #f44336;
	color: white;
	padding: 8px 12px;
	border-radius: 5px;
}

</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.querySelector("#searchInput");
    const eventTableBody = document.querySelector("#eventTableBody");

    if (!searchInput || !eventTableBody) {
        console.error("Missing elements: searchInput or eventTableBody not found.");
        return;
    }

    searchInput.addEventListener("input", function () {
        const keyword = searchInput.value.trim();

        if (keyword.length === 0) {
            fetch("/admin/loadAllEvents")
                .then(function (response) {
                    if (!response.ok) throw new Error("Failed to load events list");
                    return response.text();
                })
                .then(function (data) {
                    eventTableBody.innerHTML = data;
                })
                .catch(function (error) {
                    console.error("Error loading events:", error);
                });
            return;
        }

        const encodedKeyword = encodeURIComponent(keyword);
        const url = "/admin/searchEvent?keyword=" + encodedKeyword;

        console.log("Fetching with URL:", url);

        fetch(url)
            .then(function (response) {
                if (!response.ok) throw new Error("Failed to fetch");
                return response.text();
            })
            .then(function (data) {
                eventTableBody.innerHTML = data;
            })
            .catch(function (error) {
                console.error("Error fetching event:", error);
            });
    });
});
</script>

</head>

<body>

<nav>
	<ul class="nav-menu">
		<li><a href="/admin/dashboard">Home</a></li>
		<li><a href="/admin/manageStudents">Manage Students</a></li>
		<li><a href="/admin/danceForms">Dance Forms</a></li>
		<li><a href="/admin/trackFees">Track Fees</a></li>
		<li><a href="/admin/Events">Events</a></li>
		<li><a href="/admin/Gallery">Gallery</a></li>
	</ul>
</nav>

<div class="manage-container">
	<h2>Manage Events</h2>

	<div class="action-bar">
		<input type="text" id="searchInput" placeholder="Search event by name...">
		<a href="${pageContext.request.contextPath}/admin/addNewEvent">
			<button type="button">Add New Event</button>
		</a>
	</div>

	<table>
		<thead>
			<tr>
				<th>Sl.No</th>
				<th>Event Name</th>
				<th>Event Date</th>
				<th>Description</th>
				
				<th>Location</th>
				<th>Created At</th>
				<th>Updated At</th>
				<th>Edit</th>
				<th>Delete</th>
			</tr>
		</thead>
		<tbody id="eventTableBody">
			<%
				int i = 1;
				for (Event event : events) {
			%>
			<tr>
				<td><%= i++ %></td>
				<td><%= event.getEventName() %></td>
				<td><%= event.getEventDescription() %></td>
				<td><%= event.getEventDate() %></td>
				<td><%= event.getEventLocation() %></td>
				<td><%= event.getCreatedAt() %></td>
				<td><%= event.getUpdatedAt() %></td>
				<td>
					<button class="edit-btn" onclick="location.href='editEvent?event_id=<%= event.getEventId() %>'">Edit</button>
				</td>
				<td>
					<button class="delete-btn" onclick="location.href='deleteEvent?event_id=<%= event.getEventId() %>'">Delete</button>
				</td>
			</tr>
			<% } %>
		</tbody>
	</table>
</div>

</body>
</html>

<%@ include file="footer.jsp"%>
