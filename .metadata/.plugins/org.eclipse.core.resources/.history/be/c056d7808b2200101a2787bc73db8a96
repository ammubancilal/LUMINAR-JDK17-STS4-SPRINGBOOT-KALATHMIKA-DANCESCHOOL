package com.luminar.springbootkalathmika.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;

import com.luminar.springbootkalathmika.model.Event;
import com.luminar.springbootkalathmika.service.EventService;

@Controller
@RequestMapping("/admin")
public class EventController {
	
	
	@Autowired
    private EventService eventService;

    // ✅ Map the /admin/Events to events.jsp
    @GetMapping("/Events")
    public String showEventsPage(Model model) {
        List<Event> events = eventService.getAllEvents(); // Fetch all events
        model.addAttribute("events", events);             // Pass list to JSP
        return "events";  // => loads events.jsp
    }
    
    
    
    @GetMapping("/addNewEvent")
    public String addNewEventForm() {
        return "addNewEvent"; // returns addNewEvent.jsp
    }
    
    @PostMapping("/saveEvent")
    public String saveEvent(@ModelAttribute Event event) {
        eventService.saveEvent(event); // Save the event using the service
        return "redirect:/admin/Events"; // Redirect back to events listing page
    }
    
    
 // Show the event details for editing
    @GetMapping("/editEvent")
    public String showEditEventPage(@RequestParam("event_id") Long eventId, Model model) {
        // Fetch the event from the database
        Event event = eventService.getEventById(eventId);
        
        // Add the event object to the model to display it on the JSP page
        model.addAttribute("event", event);
        
        // Return the name of the JSP page for editing the event
        return "editEvent"; // This is the JSP page that will show the event details for editing
    }
    

}
