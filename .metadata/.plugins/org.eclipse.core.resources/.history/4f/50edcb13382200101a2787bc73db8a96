<%@ page contentType="text/html;charset=UTF-8" language="java"%>
<%@ include file="header.jsp"%>
<%@ page import="java.util.List"%>
<%@ page import="com.luminar.springbootkalathmika.model.TrackFee"%>

<%
    List<TrackFee> fees = (List<TrackFee>) request.getAttribute("fees");
%>

<html>
<head>
<title>Fee Records</title>
<style>
html, body {
	height: 100%;
	margin: 0;
	display: flex;
	flex-direction: column;
}

.manage-container {
	width: fit-content; /* 👈 Automatically expands to fit table */
	margin: 40px auto;
	background-color: #fff;
	padding: 30px;
	box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
	font-family: Arial, sans-serif;
	border-radius: 10px;
	overflow-x: auto;
	/* Ensures the table fits inside the container with horizontal scrolling if needed */
}

.manage-container h2 {
	text-align: center;
	color: #9C27B0;
	margin-bottom: 30px;
}

.content {
	flex: 1;
}

ul.nav-menu {
	list-style-type: none;
	padding: 0;
	margin: 20px auto 0 auto;
	display: flex;
	justify-content: center;
	gap: 25px;
}

ul.nav-menu li a {
	text-decoration: none;
	background-color: #9C27B0;
	color: white;
	padding: 12px 20px;
	border-radius: 8px;
}

ul.nav-menu li a:hover {
	background-color: #7B1FA2;
}

.action-bar {
	display: flex;
	justify-content: space-between;
	margin-bottom: 20px;
}

.action-bar input[type="text"] {
	padding: 8px;
	width: 250px;
	border: 1px solid #ccc;
	border-radius: 5px;
}

.action-bar button {
	background-color: #9C27B0;
	color: white;
	border: none;
	padding: 10px 16px;
	border-radius: 5px;
	cursor: pointer;
}

.action-bar button:hover {
	background-color: #7B1FA2;
}

table, th, td {
	border: 1px solid #ddd;
}

table {
	width: 100%;
	border-collapse: collapse;
	margin-bottom: 30px;
}

th, td {
	padding: 12px;
	text-align: left;
	border-bottom: 1px solid #ccc;
}

th {
	background-color: #9C27B0;
	color: white;
}

.edit-btn {
	background-color: #4CAF50;
	color: white;
}

.delete-btn {
	background-color: #f44336;
	color: white;
}

.btn {
	background-color: #9C27B0;
	color: white;
	padding: 10px 18px;
	border: none;
	border-radius: 6px;
	cursor: pointer;
}

.btn:hover {
	background-color: #7B1FA2;
}

.form-group {
	margin-bottom: 20px;
}

input[type="text"] {
	width: 100%;
	padding: 10px;
	border-radius: 6px;
	border: 1px solid #ccc;
}
</style>
<script>
 document.addEventListener("DOMContentLoaded", function () {
    const searchInputName = document.querySelector("#searchInputName");
    const searchInputMonth = document.querySelector("#searchInputMonth");
    const searchInputYear = document.querySelector("#searchInputYear");
    const feeTableBody = document.querySelector("#feeTableBody");

    if (!searchInputName || !searchInputMonth || !searchInputYear || !danceTableBody) {
        console.error("Missing elements for search.");
        return;
    }

    const fetchSearchResults = () => {
        const nameKeyword = searchInputName.value.trim();
        const monthKeyword = searchInputMonth.value.trim();
        const yearKeyword = searchInputYear.value.trim();

        // Build the URL for the search query
        let url = "/admin/searchFeeRecords?";

        if (nameKeyword) url += "studentName=" + encodeURIComponent(nameKeyword) + "&";
        if (monthKeyword) url += "month=" + encodeURIComponent(monthKeyword) + "&";
        if (yearKeyword) url += "year=" + encodeURIComponent(yearKeyword) + "&";

        // Remove last "&" if any
        if (url.endsWith("&")) url = url.slice(0, -1);

        fetch(url)
            .then(function (response) {
                if (!response.ok) throw new Error("Failed to fetch");
                return response.text();
            })
            .then(function (data) {
                danceTableBody.innerHTML = data;
            })
            .catch(function (error) {
                console.error("Error fetching fee records:", error);
            });
    };

    searchInputName.addEventListener("input", fetchSearchResults);
    searchInputMonth.addEventListener("change", fetchSearchResults);
    searchInputYear.addEventListener("change", fetchSearchResults);
});
</script>
</head>
<body>

	<nav>
		<ul class="nav-menu">
			<li><a href="/admin/dashboard">Home</a></li>
			<li><a href="/admin/manageStudents">Manage Students</a></li>
			<li><a href="/admin/danceForms">Dance Forms</a></li>
			<li><a href="/admin/trackFees">Track Fees</a></li>
			<li><a href="/admin/Events">Events</a></li>
			<li><a href="/admin/Gallery">Gallery</a></li>
			<li><a href="/admin/Performances">Performances</a></li>
		</ul>
	</nav>

	 <div class="manage-container">
        <h2>Student Fees</h2>

        <div class="action-bar">
            <!-- Search Inputs for Name, Month, Year -->
            <input type="text" id="searchInputName" placeholder="Search Fee Payment by Student Name...">
            <select id="searchInputMonth">
                <option value="">Search By Month</option>
                <option value="January">January</option>
                <option value="February">February</option>
                <option value="March">March</option>
                <option value="April">April</option>
                <option value="May">May</option>
                <option value="June">June</option>
                <option value="July">July</option>
                <option value="August">August</option>
                <option value="September">September</option>
                <option value="October">October</option>
                <option value="November">November</option>
                <option value="December">December</option>
            </select>
            <input type="text" id="searchInputYear" placeholder="Search by Year">

            
        </div>

        <br><br>

        <table>
            <thead>
                <tr>
                    <th>Sl.No</th>
                    <th>Student Name</th>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Fee Amount</th>
                    <th>Payment Date</th>
                    <th>Payment Status</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody id="feeTableBody">
                <% int i = 1;
                    for (TrackFee track : fees) { %>
                <tr>
                    <td><%= i++ %></td>
                    <td><%= track.getStudent().getStuName() %></td>
                    <td><%= track.getFeeMonth() %></td>
                    <td><%= track.getFeeYear() %></td>
                    <td><%= track.getFeeAmountpaid() %></td>
                    <td><%= track.getFeePaymentdate() %></td>
                    <td><%= track.getFeePaymentstatus() %></td>

                    <td>
                        <button class="edit-btn"
                            onclick="location.href='editFee?fee_id=<%= track.getFeeId() %>'">Edit</button>
                    </td>
                    <td>
                        <button class="delete-btn"
                            onclick="location.href='deleteFee?fee_id=<%= track.getFeeId() %>'">Delete</button>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>

<%@ include file="footer.jsp"%>
