<%@ page import="java.util.List" %>
<%@ page import="com.luminar.springbootkalathmika.model.Student" %>
<html>
<head>
<style>
td button {
            margin: 0 5px;
            padding: 6px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .edit-btn {
            background-color: #4CAF50;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }
         .pay-btn {
            background-color: #4169e1 ;
            color: white;
          }

</style>


</head>
<%
    List<Student> students = (List<Student>) request.getAttribute("students");
    int index = 1;
    if (students != null) {
        for (Student student : students) {
%>
<tr>
	<td><%= index++ %></td>
	<td><%= student.getStuName() %></td>
	<td><%= student.getStuDob() %></td>
	<td><%= student.getStuGender() %></td>
	<td><%= student.getStuParentname() %></td>
	<td><%= student.getStuContactnumber() %></td>
	<td><%= student.getStuEmail() %></td>
	<td><%= student.getStuAddress() %></td>
	<td><%= student.getStuDateofJoin() %></td>
	<td><%= student.getStuDanceform() %></td>
	<td><%= student.getStuLevel()%></td>
	<td>
		<button class="edit-btn"
			onclick="location.href='editStudent?stu_id=<%= student.getStuId() %>'">Edit</button>
	</td>
	<td>
		<button class="delete-btn"
			onclick="if(confirm('Are you sure?')) location.href='deleteStudent?stu_id=<%= student.getStu_id() %>'">Delete</button>

	</td>
	<td>
		<button class="pay-btn"
			onclick="location.href='addPaymentForm?stu_id=<%= student.getStu_id() %>'">Payment</button>
	</td>
</tr>
<%
        }
    }
%>
</html>