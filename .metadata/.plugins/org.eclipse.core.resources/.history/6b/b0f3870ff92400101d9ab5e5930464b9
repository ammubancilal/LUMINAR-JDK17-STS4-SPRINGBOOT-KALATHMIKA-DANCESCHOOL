<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.luminar.springbootkalathmika.model.Student" %>
<%@ include file="header.jsp" %>

<%
    Student student = (Student) request.getAttribute("StudentRecord");
    session.setAttribute("StudentRecord", student);
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Student Gallery - Kalathmika</title>
<style>
/* Base Styles */
body {
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
    background: #f5f7fa;
    color: #333;
    animation: fadeIn 1s ease-in;
}

@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

/* Navbar */
ul.nav-menu {
    list-style: none;
    padding: 0;
    margin: 20px auto;
    display: flex;
    justify-content: center;
    gap: 20px;
}

ul.nav-menu li a {
    text-decoration: none;
    background: linear-gradient(90deg, #8e2de2, #4a00e0);
    color: white;
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: 500;
    transition: background 0.4s;
}

ul.nav-menu li a:hover {
    background: linear-gradient(90deg, #4a00e0, #8e2de2);
}

/* Hero Section */
.hero {
    background: url('${pageContext.request.contextPath}/images/bh.webp') no-repeat center center/cover;
    height: 400px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    color: white;
    position: relative;
}

.hero::after {
    content: "";
    position: absolute;
    top:0; left:0; right:0; bottom:0;
    background: rgb(106, 90, 205);
}

.hero h1, .hero p {
    position: relative;
    z-index: 1;
}

.hero h1 {
    font-size: 3.2rem;
    margin-bottom: 10px;
}

.hero p {
    font-size: 1.3rem;
}

/* Section Styles */
.section {
    padding: 60px 20px;
    text-align: center;
}

.about, .founder {
    max-width: 1100px;
    margin: auto;
}

.section h2 {
    font-size: 2.5rem;
    color: #6A1B9A;
    margin-bottom: 20px;
}

.section p {
    font-size: 18px;
    line-height: 1.6;
    color: #555;
}

/* Founder Section */
.founder-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
    margin-top: 40px;
    justify-content: center;
}

.founder-card img {
    width: 300px;
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    transition: transform 0.3s;
}

.founder-card img:hover {
    transform: scale(1.05);
}

.founder-info {
    flex: 1;
    min-width: 280px;
    text-align: left;
}

/* Video Section */
.video-section {
    padding: 60px 20px;
    background: linear-gradient(135deg, #ece9e6, #ffffff);
    text-align: center;
}

.video-container {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: auto;
}

.video-container iframe {
    width: 100%;
    height: 450px;
    border-radius: 15px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
}

.watch-more {
    margin-top: 20px;
    display: inline-block;
    padding: 12px 24px;
    background: linear-gradient(90deg, #8e2de2, #4a00e0);
    color: white;
    text-decoration: none;
    border-radius: 30px;
    font-weight: 500;
    transition: background 0.4s;
}

.watch-more:hover {
    background: linear-gradient(90deg, #4a00e0, #8e2de2);
}

/* Gallery Section */
.gallery-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
    padding: 0 20px;
    margin-top: 30px;
}

.gallery img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transition: all 0.4s;
}

.gallery img:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
}

/* Testimonials */
.testimonials {
    background: #fff;
    padding: 60px 30px;
    margin: 60px auto;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    border-radius: 15px;
    max-width: 1000px;
}

.testimonials h2 {
    font-size: 2.5rem;
    color: #6A1B9A;
    margin-bottom: 30px;
}

.testimonial {
    font-style: italic;
    color: #666;
    font-size: 18px;
    margin-top: 20px;
}

/* Responsive */
@media (max-width: 768px) {
    .founder-card {
        flex-direction: column;
        text-align: center;
    }
    .video-container iframe {
        height: 300px;
    }
}
</style>
</head>

<body>

<nav>
    <ul class="nav-menu">
        <li><a href="/admin/student/dashboard">Home</a></li>
        <li><a href="/admin/student/myProfile">My Profile</a></li>
        <li><a href="/admin/student/myClasses">My Classes</a></li>
        <li><a href="/admin/student/fees">Fees</a></li>
        <li><a href="/admin/student/events">Events</a></li>
        <li><a href="/admin/student/gallery">Gallery</a></li>
    </ul>
</nav>

<!-- Hero Section -->
<section class="hero">
    <h1>Student Gallery</h1>
    <p>Celebrating Talent and Tradition at Kalathmika</p>
</section>

<!-- About Kalathmika -->
<section class="section about">
    <h2>About Kalathmika</h2>
    <p>Kalathmika School of Classical Dance nurtures the artistic spirit, instills discipline, and inspires excellence in every student. Our focus is not just on mastering technique, but on embracing the soul of Indian classical art.</p>
</section>

<!-- Founder Info -->
<section class="section founder">
    <h2>Founder & Visionary</h2>
    <div class="founder-card">
        <img src="${pageContext.request.contextPath}/images/found.jpeg" alt="Founder Photo">
        <div class="founder-info">
            <p>Smt. Radhika Suresh, a passionate exponent of Bharatanatyam and Kuchipudi, founded Kalathmika to spread cultural excellence and inspire 
            young minds through the timeless art of dance.

Address:
Kalathmika School of Classical Dance
Near Aluva Palace Road,
Aluva, Ernakulam District,
Kerala – 683101, India

Phone: +91 98765 43210

Email: contact@kalathmika.in</p>
        </div>
    </div>
</section>

<!-- Video Section -->
<section class="section video-section">
    <h2>Our Performances</h2>
    <div class="video-container">
        <iframe src="https://www.youtube.com/embed/inwuY217FF0" frameborder="0" allowfullscreen></iframe>
    </div>
    <a href="https://www.youtube.com/@kalathmikaschoolofclassica4011" class="watch-more" target="_blank">Watch More Videos</a>
</section>

<!-- Gallery Section -->
<section class="section gallery">
    <h2>Our Journey in Pictures</h2>
    <div class="gallery-container">
        <img src="${pageContext.request.contextPath}/images/stugallery1.jpg" alt="Performance 1">
        <img src="${pageContext.request.contextPath}/images/stugallery2.jpg" alt="Performance 2">
        <img src="${pageContext.request.contextPath}/images/stugallery3.jpg" alt="Performance 3">
        <img src="${pageContext.request.contextPath}/images/stugallery4.jpg" alt="Performance 4">
        <img src="${pageContext.request.contextPath}/images/stugallery5.jpg" alt="Performance 5">
        <img src="${pageContext.request.contextPath}/images/stugallery6.jpg" alt="Performance 6">
        <img src="${pageContext.request.contextPath}/images/stugallery7.jpg" alt="Performance 7">
        <img src="${pageContext.request.contextPath}/images/stugallery8.jpg" alt="Performance 8">
         <img src="${pageContext.request.contextPath}/images/bharat1.jpg" alt="Performance 8">
          <img src="${pageContext.request.contextPath}/images/bharat2.jpg" alt="Performance 8">
    </div>
</section>

<!-- Testimonials Section -->
<div class="testimonials">
    <h2>What Our Students Say</h2>
    <p class="testimonial">"Kalathmika is not just a school; it's a family where dreams are nurtured!" – Ananya</p>
    <p class="testimonial">"Every performance here becomes a lifetime memory. Proud to be a Kalathmika student!" – Haritha</p>
</div>

<%@ include file="footer.jsp" %>

</body>
</html>
