<%@ page contentType="text/html;charset=UTF-8" language="java"%>
<%@ include file="header.jsp"%>
<%@ page import="java.util.List"%>
<%@ page import="com.luminar.springbootkalathmika.model.Dance"%>

<%
    List<Dance> danceForms = (List<Dance>) request.getAttribute("danceForms");
%>

<html>
<head>
<title>Dance Forms</title>
<style>
html, body {
	height: 100%;
	margin: 0;
	display: flex;
	flex-direction: column;
}

.manage-container {
	width: fit-content; /* 👈 Automatically expands to fit table */
	margin: 40px auto;
	background-color: #fff;
	padding: 30px;
	box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
	font-family: Arial, sans-serif;
	border-radius: 10px;
	overflow-x: auto;
	/* Ensures the table fits inside the container with horizontal scrolling if needed */
}

.manage-container h2 {
	text-align: center;
	color: #9C27B0;
	margin-bottom: 30px;
}

.content {
	flex: 1;
}

ul.nav-menu {
	list-style-type: none;
	padding: 0;
	margin: 20px auto 0 auto;
	display: flex;
	justify-content: center;
	gap: 25px;
}

ul.nav-menu li a {
	text-decoration: none;
	background-color: #9C27B0;
	color: white;
	padding: 12px 20px;
	border-radius: 8px;
}

ul.nav-menu li a:hover {
	background-color: #7B1FA2;
}

.action-bar {
	display: flex;
	justify-content: space-between;
	margin-bottom: 20px;
}

.action-bar input[type="text"] {
	padding: 8px;
	width: 250px;
	border: 1px solid #ccc;
	border-radius: 5px;
}

.action-bar button {
	background-color: #9C27B0;
	color: white;
	border: none;
	padding: 10px 16px;
	border-radius: 5px;
	cursor: pointer;
}

.action-bar button:hover {
	background-color: #7B1FA2;
}

table, th, td {
	border: 1px solid #ddd;
}

table {
	width: 100%;
	border-collapse: collapse;
	margin-bottom: 30px;
}

th, td {
	padding: 12px;
	text-align: left;
	border-bottom: 1px solid #ccc;
}

th {
	background-color: #9C27B0;
	color: white;
}

.edit-btn {
	background-color: #4CAF50;
	color: white;
}

.delete-btn {
	background-color: #f44336;
	color: white;
}

.btn {
	background-color: #9C27B0;
	color: white;
	padding: 10px 18px;
	border: none;
	border-radius: 6px;
	cursor: pointer;
}

.btn:hover {
	background-color: #7B1FA2;
}

.form-group {
	margin-bottom: 20px;
}

input[type="text"] {
	width: 100%;
	padding: 10px;
	border-radius: 6px;
	border: 1px solid #ccc;
}
</style>
<script>
 document.addEventListener("DOMContentLoaded", function () {
	    const searchInput = document.querySelector("#searchInput");
	    const studentTableBody = document.querySelector("#danceTableBody");

	    if (!searchInput || !danceTableBody) {
	        console.error("Missing elements: searchInput or studentTableBody not found.");
	        return;
	    }

	    searchInput.addEventListener("input", function () {
	        const keyword = searchInput.value.trim();

	        // When input is empty, fetch full student list again
	        if (keyword.length === 0) {
	            fetch("/admin/loadAllStudents") // Replace with your default student list URL
	                .then(function (response) {
	                    if (!response.ok) throw new Error("Failed to load default student list");
	                    return response.text();
	                })
	                .then(function (data) {
	                    studentTableBody.innerHTML = data;
	                })
	                .catch(function (error) {
	                    console.error("Error loading default students:", error);
	                });
	            return;
	        }
	        
	        // If input is not empty, perform search

	        const encodedKeyword = encodeURIComponent(keyword);
	        const url = "/admin/searchDance?keyword=" + encodedKeyword;

	        console.log("Fetching with URL:", url);

	        fetch(url)
	            .then(function (response) {
	                if (!response.ok) throw new Error("Failed to fetch");
	                return response.text();
	            })
	            .then(function (data) {
	                studentTableBody.innerHTML = data;
	            })
	            .catch(function (error) {
	                console.error("Error fetching dance form:", error);
	            });
	    });
	});

</script>

</head>
<body>

	<nav>
		<ul class="nav-menu">
			<li><a href="/admin/dashboard">Home</a></li>
			<li><a href="/admin/manageStudents">Manage Students</a></li>
			<li><a href="/admin/danceForms">Dance Forms</a></li>
			<li><a href="/admin/trackFees">Track Fees</a></li>
			<li><a href="/admin/Events">Events</a></li>
			<li><a href="/admin/Gallery">Gallery</a></li>
			<li><a href="/admin/Performances">Performances</a></li>
		</ul>
	</nav>

	<div class="manage-container">
		<h2>Dance Forms</h2>

		<div class="action-bar">
			<input type="text" id="searchInput"
				placeholder="Search student by name..."> <a
				href="${pageContext.request.contextPath}/admin/addNewDance">
				<button type="button">Add New Dance</button>
			</a>
		</div>

		<br>
		<br>

		<table>
			<thead>
				<tr>
					<th>Sl.No</th>
					<th>Dance Name</th>
					<th>Description</th>
					<th>Origin State</th>
					<th>Created At</th>
					<th>Updated At</th>
					<th>Edit</th>
					<th>Delete</th>
				</tr>
			</thead>
			<tbody id="danceTableBody">
				<%   int i = 1;
            
            for (Dance form : danceForms) { %>
				<tr>
					<td><%= i++ %></td>
					<td><%= form.getDance_name() %></td>
					<td><%= form.getDance_desc() %></td>
					<td><%= form.getDance_origin_state() %></td>
					<td><%= form.getDance_created_at() %></td>
					<td><%= form.getDance_updated_at() %></td>


					<td>
						<button class="edit-btn"
							onclick="location.href='editDance?dance_id=<%= form.getDance_id() %>'">Edit</button>
					</td>
					<td>
						<button class="delete-btn"
							onclick="location.href='deleteDance?dance_id=<%= form.getDance_id() %>'">Delete</button>

					</td>
				</tr>
				<% } %>
			</tbody>
		</table>
	</div>

</body>
</html>

<%@ include file="footer.jsp"%>
