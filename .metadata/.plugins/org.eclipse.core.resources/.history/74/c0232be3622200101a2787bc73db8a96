<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ include file="header.jsp" %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Gallery</title>
<style>
/* Reset + General */
body {
    font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding: 0;
    background: linear-gradient(135deg, #f3e7e9, #e3eeff);
    color: #333;
    animation: fadeIn 1s ease-in;
}

@keyframes fadeIn {
    from {opacity: 0;}
    to {opacity: 1;}
}

/* Navbar */
 ul.nav-menu {
            list-style-type: none;
            padding: 0;
            margin: 20px auto 0 auto;
            display: flex;
            justify-content: center;
            gap: 25px;
        }

        ul.nav-menu li a {
            text-decoration: none;
            background-color: #9C27B0;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
        }

        ul.nav-menu li a:hover {
            background-color: #7B1FA2;
        }

/* Main Container */
.main-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
}

/* Video */
.video-container {
    text-align: center;
}

.video-container iframe {
    width: 100%;
    max-width: 800px;
    height: 450px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
}

/* Watch More Button */
.watch-more {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 25px;
    background: #9C27B0;
    color: white;
    font-weight: bold;
    font-size: 16px;
    border-radius: 30px;
    text-decoration: none;
    transition: background 0.4s, box-shadow 0.4s;
}

.watch-more:hover {
    background: #7B1FA2;
    box-shadow: 0 8px 20px rgba(156, 39, 176, 0.4);
}

/* Gallery */
/* Gallery */
.gallery {
    padding: 60px 20px;
    text-align: center;
}

.gallery h2 {
    font-size: 2.5rem;
    color: #6A1B9A;
    margin-bottom: 40px;
}

.gallery-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); /* Adjusted for responsiveness */
    gap: 25px;
    padding: 0 20px;
}

/* Ensuring the images fill their frames properly */
.gallery img.gallery-image {
    width: 100%; /* Images take up 100% of their container */
    height: 100%; /* Ensures that images take full height of the container */
    object-fit: cover; /* Ensures the image covers the container without distortion */
    object-position: center; /* Center the image if there's any cropping */
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    transition: transform 0.4s, box-shadow 0.4s;
}

/* Hover effect for zoom */
.gallery img.gallery-image:hover {
    transform: scale(1.05); /* Slight zoom effect */
    box-shadow: 0 6px 20px rgba(0,0,0,0.25);
}


/* Testimonials */
.testimonials {
    max-width: 900px;
    margin: 80px auto;
    padding: 40px 30px;
    background: white;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    border-radius: 15px;
    animation: fadeIn 1.2s ease-in;
}

.testimonials h2 {
    font-size: 2.3rem;
    color: #6A1B9A;
    margin-bottom: 30px;
}

.testimonial {
    font-style: italic;
    color: #666;
    font-size: 18px;
    margin-bottom: 20px;
}

/* Responsive Tweaks */
@media (max-width: 768px) {
    .video-container iframe {
        height: 300px;
    }
}
@media (max-width: 480px) {
    .nav-menu {
        flex-direction: column;
        gap: 10px;
    }
}

</style>
</head>
<body>

<nav>
    <ul class="nav-menu">
        <li><a href="/admin/dashboard">Home</a></li>
        <li><a href="/admin/manageStudents">Manage Students</a></li>
        <li><a href="/admin/danceForms">Dance Forms</a></li>
        <li><a href="/admin/trackFees">Track Fees</a></li>
        <li><a href="/admin/Events">Events</a></li>
        <li><a href="/admin/Gallery">Gallery</a></li>
        
    </ul>
</nav>

<!-- Video Section -->
<div class="main-container">
    <div class="video-container">
        <iframe src="https://www.youtube.com/embed/inwuY217FF0" allowfullscreen></iframe>
        <br>
        <a href="https://www.youtube.com/@kalathmikaschoolofclassica4011" class="watch-more" target="_blank">Watch More Videos</a>
    </div>
</div>

<!-- Gallery Section -->
<div class="gallery">
    <h2>Photo Gallery</h2>
    <div class="gallery-container">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/pht1.jpeg" alt="Performance 1">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/pht2.jpeg" alt="Performance 2">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/gallery5.jpeg" alt="Performance 3">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/gallery1.jpeg" alt="Performance 4">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/gallery2.jpeg" alt="Performance 5">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/gallery3.jpeg" alt="Performance 6">
        <img class="gallery-image" src="${pageContext.request.contextPath}/images/gallery4.jpeg" alt="Performance 7">
    </div>
</div>

<!-- Testimonials Section -->
<div class="testimonials">
    <h2>What Our Students Say</h2>
    <p class="testimonial">"A beautiful space to learn and grow through the power of classical dance!" – Ananya</p>
    <p class="testimonial">"The teachers are amazing and passionate. Kalathmika changed my life." – Haritha</p>
</div>

<%@ include file="footer.jsp" %>

</body>
</html>
