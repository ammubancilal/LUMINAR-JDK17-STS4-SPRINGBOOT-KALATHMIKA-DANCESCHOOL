<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ include file="header.jsp" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Kalathmika School</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(to right, #f8e1ff, #ffffff);
        }

        .main-container {
            display: flex;
            justify-content: space-between;
            padding: 40px;
            animation: fadeIn 1.5s ease;
        }

        .about-container, .video-container {
            flex: 1;
            margin: 0 20px;
            background-color: #fff;
            padding: 30px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .about-container h2 {
            color: #9C27B0;
            text-align: center;
        }

        .video-container iframe {
            width: 100%;
            height: 315px;
        }

        .watch-more {
            margin-top: 15px;
            display: block;
            background-color: #9C27B0;
            color: white;
            padding: 10px;
            text-align: center;
            text-decoration: none;
            border-radius: 8px;
        }

        .gallery, .testimonials, .founder {
            max-width: 1000px;
            margin: 40px auto;
            background: #fff;
            padding: 30px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .gallery img {
            width: 150px;
            height: auto;
            margin: 10px;
            border-radius: 8px;
        }

        .testimonial {
            font-style: italic;
            margin-bottom: 10px;
            color: #555;
        }

        .founder img {
            float: left;
            margin-right: 20px;
            height: 120px;
            border-radius: 10px;
        }

        @keyframes fadeIn {
            from {opacity: 0;}
            to {opacity: 1;}
        }
    </style>
</head>
<body>

<nav>
    <ul class="nav-menu">
        <li><a href="#">Manage Students</a></li>
        <li><a href="#">Dance Forms</a></li>
        <li><a href="#">Track Fees</a></li>
        <li><a href="#">Events</a></li>
        <li><a href="#">Gallery</a></li>
        <li><a href="#">Performances</a></li>
    </ul>
</nav>

<div class="main-container">
    <div class="about-container">
        <h2>About Kalathmika</h2>
        <p>
            Kalathmika School of Classical Dance, based in Aluva, Kerala, is committed to nurturing the beauty and discipline of Indian classical dance. 
            With expert guidance and cultural depth, students explore various traditional dance forms with both precision and emotion.
        </p>
    </div>

    <div class="video-container">
        <iframe src="https://www.youtube.com/embed/inwuY217FF0" allowfullscreen></iframe>
        <a href="https://www.youtube.com/@kalathmika" class="watch-more" target="_blank">Watch More</a>
    </div>
</div>

<!-- Gallery Section -->
<div class="gallery">
    <h2 style="text-align: center; color:#9C27B0;">Photo Gallery</h2>
    <div style="text-align: center;">
        <img src="images/gallery1.jpg" alt="Dance Image 1">
        <img src="images/gallery2.jpg" alt="Dance Image 2">
        <img src="images/gallery3.jpg" alt="Dance Image 3">
    </div>
</div>

<!-- Testimonials -->
<div class="testimonials">
    <h2 style="text-align: center; color:#9C27B0;">What Our Students Say</h2>
    <p class="testimonial">"A beautiful space to learn and grow through the power of classical dance!" – Ananya</p>
    <p class="testimonial">"The teachers are amazing and passionate. Kalathmika changed my life." – Haritha</p>
</div>

<!-- Founder Info -->
<div class="founder">
    <img src="images/founder.jpg" alt="Founder Image">
    <h2 style="color:#9C27B0;">Meet Our Founder</h2>
    <p>
        Smt. Radhika Suresh, a passionate exponent of Bharatanatyam and Kuchipudi, founded Kalathmika to spread cultural excellence 
        and inspire young minds through the timeless art of dance.
    </p>
</div>

