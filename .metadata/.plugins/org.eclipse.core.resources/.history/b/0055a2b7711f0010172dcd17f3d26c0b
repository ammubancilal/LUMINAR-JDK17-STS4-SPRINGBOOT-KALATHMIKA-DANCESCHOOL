<%@ page contentType="text/html;charset=UTF-8"%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalathmika Admin Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        /* Header section styling */
        .header {
            background-color: #9C27B0;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            color: white;
            flex-wrap: wrap;
            width: 100%; /* Add this */
    box-sizing: border-box; /* Ensure padding doesn't break layout */
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-left img {
            height: 60px;
            width: auto;
        }

        .text-block {
            display: flex;
            flex-direction: column;
            justify-content: center;
            text-align: center;
        }

        .text-block h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }

        .text-block h2 {
            margin: 4px 0 0 0;
            font-size: 18px;
            font-weight: normal;
        }

        .header-right {
            margin-top: 10px;
        }

        .header-right a {
            text-decoration: none;
            color: white;
            font-weight: bold;
            padding: 8px 16px;
            border: 2px solid white;
            border-radius: 5px;
            transition: background-color 0.3s, color 0.3s;
        }

        .header-right a:hover {
            background-color: white;
            color: #9C27B0;
        }

        hr {
            border: 1px solid #ccc;
            margin: 0;
        }

        /* Responsive design */
        @media (max-width: 600px) {
            .header {
                flex-direction: column;
                text-align: center;
            }

            .header-left {
                flex-direction: column;
                align-items: center;
            }

            .header-right {
                margin-top: 10px;
            }

            .text-block h1 {
                font-size: 22px;
            }

            .text-block h2 {
                font-size: 16px;
            }
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="header-left">
            <img src="${pageContext.request.contextPath}/images/nadaraja.jpg" alt="Kalathmika Logo">
            <div class="text-block">
                <h1>KALATHMIKA</h1>
                <h2>School of Classical Dance</h2>
            </div>
        </div>
        <div class="header-right">
            <a href="${pageContext.request.contextPath}/index">Sign Out</a>
        </div>
    </div>

    <hr>

</body>
</html>
