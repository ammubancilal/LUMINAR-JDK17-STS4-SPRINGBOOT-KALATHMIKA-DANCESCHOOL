package com.luminar.springbootkalathmika.repository;

import java.util.List;
import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import com.luminar.springbootkalathmika.model.Student;

@Repository
public interface StudentRepository extends JpaRepository<Student, Integer> {
	List<Student> findByStuNameContainingIgnoreCase(String keyword);

	Optional<Student> findByMemId(int memId);

	

	

	

}
