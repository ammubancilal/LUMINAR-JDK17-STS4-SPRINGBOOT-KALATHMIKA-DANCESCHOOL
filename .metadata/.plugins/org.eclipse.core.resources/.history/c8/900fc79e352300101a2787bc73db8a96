<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ include file="header.jsp" %>
<!DOCTYPE html>
<html>
<head>
    <title>Student Dashboard - Kalathmika</title>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(to right, #ffe5b4, #fff8dc);
            margin: 0;
            padding: 0;
        }

        ul.nav-menu {
            list-style-type: none;
            padding: 0;
            margin: 20px auto 0 auto;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 25px;
        }

        ul.nav-menu li a {
            text-decoration: none;
            background-color: #9C27B0;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            transition: background-color 0.3s ease;
        }

        ul.nav-menu li a:hover {
            background-color: #7B1FA2;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 40px auto;
            background: white;
            padding: 40px;
            box-shadow: 0 0 20px rgba(0,0,0,0.15);
            border-radius: 12px;
            text-align: center;
        }

        .dashboard-title {
            font-size: 32px;
            color: #7B1FA2;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .dashboard-section {
            margin: 40px 0;
        }

        .dashboard-section h3 {
            color: #9C27B0;
            margin-bottom: 15px;
            font-size: 24px;
        }

        .btn {
            background-color: #9C27B0;
            color: white;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
            margin: 10px;
            display: inline-block;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: #7B1FA2;
        }

        .bharatanatyam-gallery {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .bharatanatyam-gallery img {
            width: 250px;
            height: 200px;
            object-fit: cover;
            border-radius: 12px;
            transition: transform 0.3s;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
        }

        .bharatanatyam-gallery img:hover {
            transform: scale(1.05);
        }

        @media (max-width: 768px) {
            ul.nav-menu {
                flex-direction: column;
                gap: 15px;
            }
            .bharatanatyam-gallery img {
                width: 90%;
                height: auto;
            }
        }
    </style>
</head>
<body>

<nav>
    <ul class="nav-menu">
        <li><a href="/student/dashboard">Home</a></li>
        <li><a href="/student/myProfile">My Profile</a></li>
        <li><a href="/student/myClasses">My Classes</a></li>
        <li><a href="/student/fees">Fees</a></li>
        <li><a href="/student/events">Events</a></li>
        <li><a href="/logout">Logout</a></li>
    </ul>
</nav>

<div class="dashboard-container">
    <h1 class="dashboard-title">Welcome, ${studentName}!</h1>

    <div class="dashboard-section">
        <h3>My Classes</h3>
        <p>View your class schedules, dance forms, and timings.</p>
        <a href="/student/myClasses" class="btn">View Classes</a>
    </div>

    <div class="dashboard-section">
        <h3>Fees</h3>
        <p>Track your fee payments and dues.</p>
        <a href="/student/fees" class="btn">Track Fees</a>
    </div>

    <div class="dashboard-section">
        <h3>Upcoming Events</h3>
        <p>Check upcoming performances and competitions.</p>
        <a href="/student/events" class="btn">View Events</a>
    </div>

    <div class="dashboard-section">
        <h3>My Profile</h3>
        <p>Update your personal details and change password.</p>
        <a href="/student/myProfile" class="btn">View Profile</a>
    </div>

    <div class="dashboard-section">
        <h3>Bharatanatyam Moments</h3>
        <div class="bharatanatyam-gallery">
            <img src="${pageContext.request.contextPath}/images/bharat1.jpg" alt="Bharatanatyam 1">
            <img src="${pageContext.request.contextPath}/images/bharat2.jpg" alt="Bharatanatyam 2">
            <img src="${pageContext.request.contextPath}/images/bharatha.jpg" alt="Bharatanatyam 3">
        </div>
    </div>

</div>

</body>
</html>
<%@ include file="footer.jsp" %>
