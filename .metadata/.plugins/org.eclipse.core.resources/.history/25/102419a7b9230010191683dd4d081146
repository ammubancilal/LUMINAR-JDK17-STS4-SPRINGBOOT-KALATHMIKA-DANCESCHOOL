<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ include file="header.jsp" %>
<!DOCTYPE html>
<html>
<head>
    <title>Student Dashboard</title>
    <style>
        ul.nav-menu {
            list-style-type: none;
            padding: 0;
            margin: 20px auto 0 auto;
            display: flex;
            justify-content: center;
            gap: 25px;
        }

        ul.nav-menu li a {
            text-decoration: none;
            background-color: #9C27B0;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
        }

        ul.nav-menu li a:hover {
            background-color: #7B1FA2;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #f3e5f5, #ede7f6);
            margin: 0;
            padding: 0;
            overflow-x: hidden; /* prevent horizontal scroll */
        }

        .dashboard-container {
            max-width: 1100px;
            margin: 40px auto;
            background: white;
            padding: 40px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            border-radius: 10px;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .dashboard-title {
            font-size: 32px;
            color: #7B1FA2;
            margin-bottom: 20px;
        }

        .dashboard-section {
            margin: 40px 0;
        }

        .dashboard-section h3 {
            color: #9C27B0;
            margin-bottom: 20px;
            font-size: 24px;
        }

        .btn {
            background-color: #9C27B0;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            text-decoration: none;
            margin: 10px;
            display: inline-block;
            font-size: 16px;
        }

        .btn:hover {
            background-color: #7B1FA2;
        }

        /* Side images styling */
        .side-image {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 200px;
            height: auto;
            z-index: 1;
            opacity: 0;
        }

        .side-image.left {
            left: 20px;
            animation: fadeSlideInLeft 1.5s ease forwards, float 4s ease-in-out infinite;
        }

        .side-image.right {
            right: 20px;
            animation: fadeSlideInRight 1.5s ease 0.3s forwards, float 4s ease-in-out infinite;
        }

        @keyframes fadeSlideInLeft {
            0% {
                opacity: 0;
                transform: translate(-100px, -50%);
            }
            100% {
                opacity: 1;
                transform: translate(0, -50%);
            }
        }

        @keyframes fadeSlideInRight {
            0% {
                opacity: 0;
                transform: translate(100px, -50%);
            }
            100% {
                opacity: 1;
                transform: translate(0, -50%);
            }
        }

        @keyframes float {
            0% {
                transform: translateY(-50%) translateY(0);
            }
            50% {
                transform: translateY(-50%) translateY(-10px);
            }
            100% {
                transform: translateY(-50%) translateY(0);
            }
        }

        @media (max-width: 768px) {
            .side-image {
                display: none;
            }
        }

    </style>
</head>
<body>

<nav>
    <ul class="nav-menu">
        <li><a href="/student/dashboard">Home</a></li>
        <li><a href="/student/myProfile">My Profile</a></li>
        <li><a href="/student/myClasses">My Classes</a></li>
        <li><a href="/student/fees">Fees</a></li>
        <li><a href="/student/events">Events</a></li>
        <li><a href="/logout">Logout</a></li>
    </ul>
</nav>

<!-- Side Images -->
<img src="${pageContext.request.contextPath}/images/bharatanatyam1.jpg" alt="Left Image" class="side-image left">
<img src="${pageContext.request.contextPath}/images/bharatanatyam2.jpg" alt="Right Image" class="side-image right">

<div class="dashboard-container">
    <h1 class="dashboard-title">Welcome, ${studentName}!</h1>

    <div class="dashboard-section">
        <h3>My Classes</h3>
        <p>View your class schedules, dance forms, and timings.</p>
        <a href="/student/myClasses" class="btn">View Classes</a>
    </div>

    <div class="dashboard-section">
        <h3>Fees</h3>
        <p>Track your fee payments and dues.</p>
        <a href="/student/fees" class="btn">Track Fees</a>
    </div>

    <div class="dashboard-section">
        <h3>Upcoming Events</h3>
        <p>Check upcoming performances and competitions.</p>
        <a href="/student/events" class="btn">View Events</a>
    </div>

    <div class="dashboard-section">
        <h3>My Profile</h3>
        <p>Update your personal details and change password.</p>
        <a href="/student/myProfile" class="btn">View Profile</a>
    </div>
</div>

</body>
</html>
<%@ include file="footer.jsp" %>
