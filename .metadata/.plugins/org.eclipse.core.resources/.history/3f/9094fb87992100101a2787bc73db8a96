<%@ page import="java.util.List" %>
<%@ page import="com.luminar.springbootkalathmika.model.Student" %>
<html>
<head>
<style>
td button {
            margin: 0 5px;
            padding: 6px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .edit-btn {
            background-color: #4CAF50;
            color: white;
        }

        .delete-btn {
            background-color: #f44336;
            color: white;
        }

</style>


</head>
<%
    List<Student> students = (List<Student>) request.getAttribute("students");
    int index = 1;
    if (students != null) {
        for (Student student : students) {
%>
    <tr>
        <td><%= index++ %></td>
        <td><%= student.getStu_name() %></td>
        <td><%= student.getStu_dob() %></td>
        <td><%= student.getStu_gender() %></td>
        <td><%= student.getStu_parent_name() %></td>
        <td><%= student.getStu_contact_number() %></td>
        <td><%= student.getStu_email() %></td>
        <td><%= student.getStu_address() %></td>
        <td><%= student.getStu_dateof_join() %></td>
        <td><%= student.getStu_dance_form() %></td>
        <td><%= student.getStu_level() %></td>
        <td>
            <button class="edit-btn" onclick="location.href='editStudent?stu_id=<%= student.getStu_id() %>'">Edit</button></td>
           <td> <button class="delete-btn" onclick="if(confirm('Are you sure?')) location.href='deleteStudent?stu_id=<%= student.getStu_id() %>'">Delete</button>
        </td>
    </tr>
<%
        }
    }
%>
</html>