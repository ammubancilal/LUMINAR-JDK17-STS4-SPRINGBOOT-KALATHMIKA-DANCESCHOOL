<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.luminar.springbootkalathmika.model.Student" %>
<%@ include file="header.jsp" %>
<%@ page import="java.util.List"%>
<%@ page import="com.luminar.springbootkalathmika.model.TrackFee"%>

<%
    Student student = (Student) request.getAttribute("StudentRecord");
session.setAttribute("StudentRecord", student);

List<TrackFee> fees = (List<TrackFee>) request.getAttribute("FeeRecord");


%>

<!DOCTYPE html>
<html>
<head>
    <title>My Profile</title>
    <style>
       /* Reset default margin and padding for html and body */
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Background and gradient */
body {
    background: 
        linear-gradient(to right, rgba(243,229,245,0.8), rgba(237,231,246,0.8)),
        url('${pageContext.request.contextPath}/images/bharat.webp') no-repeat left, 
        url('${pageContext.request.contextPath}/images/bharat.webp') no-repeat right;
    background-size: 30%;
    background-position: left center, right center;
    background-attachment: fixed;
}

/* Traditional Indian Borders (Top and Bottom) */
body::before, body::after {
    content: "";
    position: fixed;
    left: 0;
    width: 100%;
    height: 30px;
    background: url('https://via.placeholder.com/1920x30/fff/ff6347?text=Indian+Pattern') repeat-x;
    z-index: 1;
}

body::before {
    top: 0;
}

body::after {
    bottom: 0;
}


.action-bar {
	display: flex;
	justify-content: space-between;
	margin-bottom: 20px;
}

.action-bar input[type="text"] {
	padding: 8px;
	width: 250px;
	border: 1px solid #ccc;
	border-radius: 5px;
}

.action-bar button {
	background-color: #9C27B0;
	color: white;
	border: none;
	padding: 10px 16px;
	border-radius: 5px;
	cursor: pointer;
}

.action-bar button:hover {
	background-color: #7B1FA2;
}

table, th, td {
	border: 1px solid #ddd;
}

table {
	width: 100%;
	border-collapse: collapse;
	margin-bottom: 30px;
}

th, td {
	padding: 12px;
	text-align: left;
	border-bottom: 1px solid #ccc;
}

th {
	background-color: #9C27B0;
	color: white;
}


/* Navigation Styles */
nav ul.nav-menu {
    list-style: none;
    padding: 0;
    margin: 20px auto 0;
    display: flex;
    justify-content: center;
    gap: 25px;
}

nav ul.nav-menu li a {
    text-decoration: none;
    background-color: #9C27B0;
    color: white;
    padding: 12px 20px;
    border-radius: 8px;
    transition: background-color 0.3s ease;
}

nav ul.nav-menu li a:hover {
    background-color: #7B1FA2;
}





/* Buttons */
.btn-container {
    text-align: center;
    margin-top: 30px;
}

.btn {
    background-color: #7B1FA2;
    color: white;
    padding: 10px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-size: 16px;
}

.btn:hover {
    background-color: #6A1B9A;
}

/* Flexbox for placing images on left and right sides */
.bharatanatyam-gallery {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 30px;
}

.bharatanatyam-gallery .image-left,
.bharatanatyam-gallery .image-right {
    width: 15%;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
}

.bharatanatyam-gallery img {
    width: 100%;
    max-width: 300px;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 0 10px rgba(0,0,0,0.2);
    transition: transform 0.3s ease;
}

.bharatanatyam-gallery img:hover {
    transform: scale(1.05);
}

/* Mobile responsive */
@media (max-width: 768px) {
    .bharatanatyam-gallery {
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: static;
    }

    .bharatanatyam-gallery .image-left,
    .bharatanatyam-gallery .image-right {
        width: 80%;
        margin-bottom: 15px;
    }

    .profile-container {
        margin: 20px;
        padding: 20px;
    }
    
    
    
    
    
    
    
    .manage-container {
	width: fit-content;
	margin: 40px auto;
	background-color: #fff;
	padding: 30px;
	box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
	font-family: Arial, sans-serif;
	border-radius: 10px;
	overflow-x: auto;
}

.manage-container h2 {
	text-align: center;
	color: #9C27B0;
	margin-bottom: 30px;
}

ul.nav-menu {
	list-style-type: none;
	padding: 0;
	margin: 20px auto 0 auto;
	display: flex;
	justify-content: center;
	gap: 25px;
}

ul.nav-menu li a {
	text-decoration: none;
	background-color: #9C27B0;
	color: white;
	padding: 12px 20px;
	border-radius: 8px;
}

ul.nav-menu li a:hover {
	background-color: #7B1FA2;
}



    
    
    
    


    </style>
    
   <script>
document.addEventListener("DOMContentLoaded", function () {
    const searchInputMonth = document.getElementById("searchInputMonth");
    const searchInputYear = document.getElementById("searchInputYear");
    const feeTableBody = document.getElementById("feeTableBody");
    
    const studentId = <%= student.getStuId() %>;

    function loadAllFees() {
        fetch("/admin/student/loadAllFees")
            .then(response => response.text())
            .then(data => feeTableBody.innerHTML = data)
            .catch(error => console.error("Error loading all Fees:", error));
    }

    function searchFees(month, year,id) {
        let url = "/admin/student/searchFee?";
        if (month) {
            url += `month=${encodeURIComponent(month)}&`;
        }
        if (year) {
            url += `year=${encodeURIComponent(year)}`;
        }

        fetch(url)
            .then(response => response.text())
            .then(data => {
                feeTableBody.innerHTML = data;
            })
            .catch(error => console.error("Error searching fees:", error));
    }

    function handleSearch() {
        const keywordMonth = searchInputMonth.value.trim();
        const keywordYear = searchInputYear.value.trim();
        if (keywordMonth.length === 0 && keywordYear.length === 0) {
            loadAllFees();
        } else {
            searchFees(keywordMonth, keywordYear,studentId);
        }
    }

    searchInputMonth.addEventListener("input", handleSearch);
    searchInputYear.addEventListener("input", handleSearch);

    // Initial load
    loadAllFees();
});
</script>

</head>
<body>


<nav>
    <ul class="nav-menu">
        <li><a href="/admin/student/dashboard">Home</a></li>
        <li><a href="/admin/student/myProfile">My Profile</a></li>
        <li><a href="/admin/student/myClasses">My Classes</a></li>
        <li><a href="/admin/student/fees">Fees</a></li>
        <li><a href="/admin/student/events">Events</a></li>
       
    </ul>
</nav>

<div class="manage-container">
	<h2>Payment Record Of <%=student.getStuName() %></h2>

	<div class="action-bar">
		<input type="text" id="searchInputMonth" placeholder="Search Payment Records By Month">
		
	</div>
	<div class="action-bar">
		<input type="text" id="searchInputYear" placeholder="Search Payment Records By Year">
		
	</div>

	<table>
		<thead>
			<tr>
				<th>Sl.No</th>
				<th>Paid Months</th>
				<th>Paid Year</th>
				<th>Paid Amount</th>
				<th>Date Of Payment</th>
				
				
				<th>Payment Status</th>
				
				
			</tr>
		</thead>
		<tbody id="feeTableBody">
			<%
				int i = 1;
				for (TrackFee fee : fees) {
			%>
			<tr>
				<td><%= i++ %></td>
				<td><%= fee.getFeeMonth() %></td>
				<td><%= fee.getFeeYear() %></td>
				<td><%= fee.getFeeAmountpaid() %></td>
				<td><%= fee.getFeePaymentdate() %></td>
				<td><%= fee.getFeePaymentstatus() %></td>
				
			</tr>
			<% } %>
		</tbody>
	</table>
</div>

</body>
</html>

<%@ include file="footer.jsp" %>
